<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>

	<!-- Metadata -->
	<AssemblyName>Ytdlp.executable</AssemblyName>
	<RootNamespace>Yytdlp.executable</RootNamespace>
	<PackageId>ytdlp-executable</PackageId>
	
	<Description>A NuGet package that provides the latest version of `yt-dlp.exe`.</Description>
	<Authors>Manojbabu</Authors>
	<Company>ManuHub</Company>
	<Copyright>Copyright © $([System.DateTime]::Now.Year) ManuHub</Copyright>
	
	<PackageTags>yt-dlp;deno;deno.exe;runtime;javascript;youtube;youtube-dl;external-runtime</PackageTags>
	  
	<ProjectUrl>https://github.com/yt-dlp/yt-dlp</ProjectUrl>
	<RepositoryUrl>https://github.com/manusoft/ManuHub-Ytdlp-Builds</RepositoryUrl>
	<RepositoryType>git</RepositoryType>

	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageIcon>icon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>

	<!-- Version is auto-updated by GitHub Actions workflow -->
	<Version>2026.7.4</Version>

	<!-- Binary-only / content-only package -->
	<IsPackable>true</IsPackable>
	<IncludeBuildOutput>false</IncludeBuildOutput>
	<IncludeContentInPack>true</IncludeContentInPack>

	<!-- Suppress only the specific warning we expect -->
	<NoWarn>$(NoWarn);NU5100;NU5119;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<None Include="icon.png" Pack="true" PackagePath="" />
	<None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ManuHub.Ytdlp" Version="6.7.4" />
  </ItemGroup>
</Project>
