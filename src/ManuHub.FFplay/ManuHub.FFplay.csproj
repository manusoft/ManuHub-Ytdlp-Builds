<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<LangVersion>latest</LangVersion>

	<!-- Metadata -->
	<AssemblyName>ManuHub.FFplay</AssemblyName>
	<RootNamespace>ManuHub.FFplay</RootNamespace>
	<PackageId>ManuHub.FFplay</PackageId>
	  
	<Description>Provides the latest stable ffplay.exe Windows binary as a NuGet package. Copies ffplay.exe to the output folder for easy use in .NET applications and wrappers.</Description>
	<Authors>Manojbabu</Authors>
	<Company>ManuHub</Company>
	<Copyright>Copyright © $([System.DateTime]::Now.Year) ManuHub</Copyright>

	<PackageTags>ffplay;ffplay.exe;ffmpeg;media;player;video;audio;binary;tools</PackageTags>
	  
	<ProjectUrl>https://ffmpeg.org</ProjectUrl>
	<RepositoryUrl>https://github.com/manusoft/ManuHub-Ytdlp-Builds</RepositoryUrl>
	  
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<PackageIcon>icon.png</PackageIcon>
	<PackageReadmeFile>README.md</PackageReadmeFile>

	<!-- Version is auto-updated by GitHub Actions workflow -->
	<Version>6.3.12</Version>

	<!-- Binary-only / content-only package -->
	<IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
	<IncludeContentInPack>true</IncludeContentInPack>
	  
	<!-- Suppress only the specific warning we expect -->
	<NoWarn>$(NoWarn);NU5100;NU5119;NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
	<None Include="icon.png" Pack="true" PackagePath="" />
	<None Include="README.md" Pack="true" PackagePath="" />
	<None Include="LICENSE.txt" Pack="true" PackagePath="" />
	<None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
