<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Metadata -->
		<AssemblyName>ManuHub.Deno</AssemblyName>
		<RootNamespace>ManuHub.Deno</RootNamespace>
		<PackageId>ManuHub.Deno</PackageId>
		
		<Description>Provides the latest stable deno.exe Windows binary as a NuGet package. Copies deno.exe to the output folder for easy use in .NET applications and wrappers.</Description>
		<Authors>Manojbabu</Authors>
		<Company>ManuHub</Company>
		<Copyright>Copyright © $([System.DateTime]::Now.Year) ManuHub</Copyright>
		
		<PackageTags>yt-dlp;deno;deno.exe;runtime;javascript;youtube;youtube-dl;external-runtime</PackageTags>

		<ProjectUrl>https://deno.com</ProjectUrl>
		<RepositoryUrl>https://github.com/manusoft/ManuHub-Ytdlp-Builds</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- Version is auto-updated by GitHub Actions workflow -->
		<Version>2.6.10</Version>

		<!-- Binary-only / content-only package -->
		<IsPackable>true</IsPackable>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<IncludeContentInPack>true</IncludeContentInPack>

		<!-- Suppress only the specific warning we expect -->
		<NoWarn>$(NoWarn);NU5100;NU5119;NU5128</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" PackagePath="" />
		<None Include="README.md" Pack="true" PackagePath="" />
		<None Include="LICENSE.txt" Pack="true" PackagePath="" />
		<None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
	</ItemGroup>
</Project>
